# Required: credentials and endpoint of your upstream model service (not the SPC gateway).
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=

# OPTIONAL: select a non-OpenAI provider, change the gateway port, or set its browser-visible token.
# AI_PROVIDER=openai
# AI_GATEWAY_PORT=8001
# AI_GATEWAY_API_KEY=replace-with-a-gateway-token

# OPTIONAL: adjust generation temperature, output limits, timeouts, or agent work limits.
# DSPY_TEMPERATURE=0
# DSPY_MAX_TOKENS=220
# DSPY_TIMEOUT_SECONDS=20
# DSPY_AGENT_MAX_ITERS=5
# DSPY_AGENT_DEADLINE_SECONDS=90
# DSPY_AGENT_MAX_TOKENS=1024
# DSPY_HTML_MAX_TOKENS=3000
# DSPY_MAX_REQUEST_CHARS=16000
# DSPY_JSON_ADAPTER_FALLBACK=false

# OPTIONAL: custom Python package sources for Docker builds (trusted hosts disable TLS verification).
# DSPY_PIP_INDEX_URL=
# DSPY_PIP_EXTRA_INDEX_URL=
# DSPY_PIP_TRUSTED_HOST=

# OPTIONAL: trust a corporate CA bundle for outbound HTTPS (mount it at this path in Docker).
# REQUESTS_CA_BUNDLE=
# SSL_CERT_FILE=

# OPTIONAL: legacy aliases AI_API_BASE, DSPY_API_BASE, DSPY_API_KEY and
# VITE_AI_* remain supported. Canonical AI_* settings take precedence.
